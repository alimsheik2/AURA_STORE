# ==============================================================================
# AURA STORE — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# These variables are bundled into the client application. NEVER place secrets here.
# ------------------------------------------------------------------------------
# Supabase Project Credentials (Settings > API in Supabase Dashboard)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Cloudflare Turnstile Bot Protection (Public Site Key)
VITE_TURNSTILE_SITE_KEY=""

# Stripe Publishable Key (Client Checkout)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Development only: Set to "true" if you explicitly want in-memory mock during local testing
VITE_USE_MOCK_SUPABASE="false"

# ------------------------------------------------------------------------------
# 2. BACKEND SECRETS (Supabase Edge Functions Secrets)
# DO NOT put these in client .env! Set them via:
# `supabase secrets set KEY=VALUE` or in Supabase Dashboard (Settings > Edge Functions).
# ------------------------------------------------------------------------------
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
# RESEND_API_KEY="your-resend-api-key"
# OTP_FROM_EMAIL="noreply@aura.store"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# PAYPAL_CLIENT_ID="your_paypal_client_id"
# PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
# PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"